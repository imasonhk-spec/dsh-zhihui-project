# Project manager API
PORT=3100
HOST=127.0.0.1
NODE_ENV=development
WEB_ALLOWED_ORIGINS=http://127.0.0.1:3200,http://localhost:3200

# PostgreSQL (recommended because pgvector can be added later)
DATABASE_URL=postgres://pm_user:pm_password@127.0.0.1:55432/project_manager

# Project-dedicated local services (ports avoid colliding with existing host services)
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=project-manager
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Current multipart implementation buffers one file in memory; keep this conservative until streaming upload lands.
S3_MAX_OBJECT_BYTES=20971520

# Local OCR (10.3): binaries and language data must be provisioned locally; no cloud OCR is used.
TESSERACT_PATH=tesseract
PDFTOPPM_PATH=pdftoppm
PDFINFO_PATH=pdfinfo
TESSDATA_PREFIX=/path/to/tessdata
# Alternatively provide individual immutable traineddata files instead of TESSDATA_PREFIX.
# KNOWLEDGE_OCR_ENG_DATA=/path/to/eng.traineddata
# KNOWLEDGE_OCR_CHI_SIM_DATA=/path/to/chi_sim.traineddata
KNOWLEDGE_OCR_MAX_IMAGE_PIXELS=25000000
KNOWLEDGE_OCR_MAX_PAGES=50
KNOWLEDGE_OCR_PDF_DPI=250
KNOWLEDGE_OCR_PAGE_TIMEOUT_MS=60000
KNOWLEDGE_OCR_DOCUMENT_TIMEOUT_MS=600000
KNOWLEDGE_OCR_LOW_CONFIDENCE=70

# Local/internal Embedding service (10.5; bge-m3 outputs 1024 dimensions)
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_BATCH_SIZE=16

# Optional shared LLM Wiki vector/knowledge service (0.6.11)
LLM_WIKI_API_BASE_URL=http://127.0.0.1:19928
LLM_WIKI_API_TOKEN=inject-from-secret-store
LLM_WIKI_TIMEOUT_MS=15000

# DeepSeek Harness native RPC
DSH_BASE_URL=http://127.0.0.1:3080
DSH_EVENTS_URL=ws://127.0.0.1:3080/api/events.mux
DSH_PROVIDER=deepseep
DSH_MODEL=qwen3.8-max
DSH_AGENT_PRESET=minimal
DSH_TIMEOUT_MS=15000
DSH_ANSWER_TIMEOUT_MS=120000
DSH_POLL_INTERVAL_MS=500
