[Unit]
Description=Opportunity Manager API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lgsj/harness/bussiness-manager
Environment=PATH=/home/lgsj/.local/pnpm/bin:/home/lgsj/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
Environment=OPPORTUNITY_PORT=3211
ExecStart=/home/lgsj/.local/pnpm/bin/pnpm dev:api
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
