{
  "name": "project-delivery-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev": "pnpm dev:api",
    "build:api": "tsc -b tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "pnpm build:api && pnpm build:web",
    "typecheck:api": "tsc -b tsconfig.json --pretty false",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --pretty false",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:web",
    "test": "tsx --test $(find apps/api/src -type f -name '*.test.ts' -print | sort)",
    "test:g3-tools": "bash scripts/ict-g3-differential-tools.test.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "probe:dsh": "tsx scripts/probe-deepseek-harness.ts",
    "smoke:vector": "tsx scripts/smoke-vector-store.ts",
    "smoke:parser": "tsx scripts/smoke-document-parser.ts",
    "smoke:processing": "tsx scripts/smoke-document-processing.ts",
    "smoke:ocr": "tsx scripts/smoke-ocr.ts",
    "smoke:ocr:processing": "tsx scripts/smoke-ocr-processing.ts",
    "smoke:search": "tsx scripts/smoke-full-text-search.ts",
    "smoke:hybrid": "tsx scripts/smoke-hybrid-search.ts",
    "smoke:ai": "tsx scripts/smoke-ai-conversations.ts",
    "smoke:ai:rag": "tsx scripts/smoke-ai-rag.ts",
    "smoke:ai:stream": "tsx scripts/smoke-ai-stream.ts",
    "smoke:ai:feedback": "tsx scripts/smoke-ai-feedback.ts",
    "smoke:ai:security": "tsx scripts/smoke-ai-security.ts",
    "smoke:meeting-todos": "tsx scripts/smoke-meeting-todo-import.ts",
    "smoke:meeting-dashboard": "tsx scripts/smoke-meeting-todo-dashboard.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/smoke",
    "verify:11.5": "pnpm typecheck && pnpm smoke:ai:security && pnpm smoke:ai:feedback && pnpm smoke:ai:stream && pnpm smoke:ai:rag && pnpm smoke:ai && pnpm smoke:hybrid && pnpm build",
    "verify:kb-integration": "tsx scripts/verify-kb-integration-assets.ts",
    "verify:kb-protected": "node scripts/kb-modernization/verify-protected-manifest.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.6",
    "@aws-sdk/client-s3": "^3.888.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
