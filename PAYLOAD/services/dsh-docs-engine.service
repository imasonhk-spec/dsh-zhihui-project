[Unit]
Description=Tencent Docs editor_sdk (win32, via Wine) — local document engine for slidep (:39099)
After=network.target

[Service]
Type=simple
User=lgsj
Group=lgsj
Environment=HOME=/home/lgsj
Environment=LANG=zh_CN.UTF-8
Environment=LC_ALL=zh_CN.UTF-8
Environment=WINEPREFIX=/home/lgsj/.wine-editor
Environment=WINEDEBUG=-all
Environment=WINEARCH=win64
Environment=WINEDLLOVERRIDES=mscoree,mshtml=
WorkingDirectory=/
ExecStart=/usr/bin/wine /home/lgsj/.slidep-engine/editor_sdk.exe --port 39099 --cors_origin=* -td_proxy=true
Restart=always
RestartSec=3
StandardOutput=append:/home/lgsj/.slidep-engine/engine-service.log
StandardError=append:/home/lgsj/.slidep-engine/engine-service.log

[Install]
WantedBy=multi-user.target
